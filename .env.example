# Mot de passe pour entrer dans le studio. Vide = pas de protection (à éviter en ligne).
APP_PASSWORD=

# Base Postgres (Neon via Vercel Marketplace). Vide = fichier local .data/db.json (dev uniquement).
DATABASE_URL=

# Stockage des visuels (Vercel Blob). Vide = dossier .data/uploads (dev uniquement).
BLOB_READ_WRITE_TOKEN=

# Clé API Claude pour le générateur de concepts. Vide = mixeur intégré.
ANTHROPIC_API_KEY=

# Jeton de la synchro des stats (POST /api/stats). Vide = synchro fermée.
STATS_API_TOKEN=
